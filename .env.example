# =============================================================================
# ThreadFlow — environment template
#
#   cp .env.example .env
#
# APP_ENV selects runtime policy. Use `development` for local HTTP and
# `production` behind HTTPS. Never commit `.env`.
# =============================================================================


# ── Environment and public endpoints ───────────────────────────────────────
APP_ENV=development
APP_NAME=ThreadFlow
APP_VERSION=0.1.0
PUBLIC_BASE_URL=http://localhost:8080
HTTP_PORT=8080

# ── Django ──────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,host.docker.internal
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8080

# development over HTTP: false; production behind HTTPS: true
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
ACCESS_COOKIE_NAME=threadflow_access
REFRESH_COOKIE_NAME=threadflow_refresh
CSRF_COOKIE_NAME=threadflow_csrftoken

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# Compose overrides the container host/port to postgres:5432.
POSTGRES_DB=threadflow
POSTGRES_USER=threadflow
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_PORT_HOST=5433
POSTGRES_CONN_MAX_AGE=60

# ── Redis ───────────────────────────────────────────────────────────────────
# CAPTCHA, rate limits, cache and outbox publisher locks.
REDIS_IMAGE=redis:8.10.0-alpine
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@localhost:6380/0
REDIS_PORT_HOST=6380
REDIS_CACHE_PREFIX=threadflow
CAPTCHA_TTL_SECONDS=300
CAPTCHA_MAX_ATTEMPTS=3
RATE_LIMIT_COMMENT_PER_MINUTE=10
RATE_LIMIT_NUM_PROXIES=1
POPULAR_PAGE_CACHE_TTL_SECONDS=60

# ── JWT and authentication ─────────────────────────────────────────────────
# Access and refresh secrets must be different.
# Generate each: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=threadflow
JWT_AUDIENCE=threadflow-spa
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=14
JWT_REFRESH_ROTATION=true

# ── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CLIENT_ID=threadflow
KAFKA_CONSUMER_GROUP_PREFIX=threadflow
KAFKA_TOPIC_COMMENTS_CREATED=comments.created
KAFKA_TOPIC_COMMENTS_UPDATED=comments.updated
KAFKA_TOPIC_ATTACHMENTS_UPLOADED=attachments.uploaded
KAFKA_TOPIC_SEARCH_INDEX=search.index
KAFKA_TOPIC_RETRY=events.retry
KAFKA_TOPIC_DLQ=events.dlq
KAFKA_RETRY_MAX_ATTEMPTS=5
KAFKA_RETRY_BACKOFF_SECONDS=5
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_SECONDS=1

# ── Elasticsearch ───────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX=threadflow-comments-v1
ELASTICSEARCH_REQUEST_TIMEOUT_SECONDS=10
ELASTICSEARCH_JAVA_OPTS="-Xms512m -Xmx512m"

# ── Object storage — MinIO locally, AWS S3 in production ───────────────────
STORAGE_BACKEND=minio
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=threadflow
S3_ACCESS_KEY_ID=threadflow
S3_SECRET_ACCESS_KEY=change-me
S3_USE_SSL=false
MINIO_ROOT_USER=threadflow
MINIO_ROOT_PASSWORD=change-me
ATTACHMENT_MAX_BYTES=10485760
TXT_MAX_BYTES=102400
IMAGE_MAX_WIDTH=320
IMAGE_MAX_HEIGHT=240

# ── WebSocket ───────────────────────────────────────────────────────────────
WS_PATH=/ws/comments
WS_HEARTBEAT_INTERVAL_SECONDS=20
WS_MAX_CONNECTIONS_PER_USER=5
WS_CHANNEL_CAPACITY=1000
WS_EVENT_EXPIRY_SECONDS=60

# ── Demo bootstrap ──────────────────────────────────────────────────────────
# Leave DEMO_USER_PASSWORD empty to skip demo-user creation.
DEMO_USER_NAME=demo
DEMO_USER_EMAIL=demo@threadflow.local
DEMO_USER_PASSWORD=

# ── Logging, metrics and error reporting ───────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=console
METRICS_ENABLED=true
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
